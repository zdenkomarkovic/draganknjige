# ============================================
# KOPIRATI u .env.local i popuniti vrednosti
# ============================================

# URL sajta (bez trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Naziv sajta
NEXT_PUBLIC_SITE_NAME=My Site

# Google Analytics (opciono)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# MariaDB: mysql://korisnik:lozinka@localhost:3306/ime_baze
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Auth secret (opciono - ako koristis NextAuth/Lucia)
# AUTH_SECRET=

# Kljuc za preuzimanje liste kupaca: /api/kupci?key=...
ADMIN_EXPORT_KEY=

# Folder sa slikama proizvoda (default: ./uploads)
# UPLOADS_DIR=
# Opciono: spoljni domen/CDN za slike (default: /uploads)
# NEXT_PUBLIC_UPLOADS_URL=
